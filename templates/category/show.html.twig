{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Boeken{% endblock %}

{% block body %}
    <h1>{{ category.name }}</h1>

    <div class="bookshelf-books">
        {% for book in books %}
            <div class="book-card">
                <a href="{{ path('book_show', {id: book.id}) }}">
                    <div class="book-image">
                        <img src="{{ asset('img/' ~ book.img) }}" alt="{{ book.title }}">
                    </div>
                    <div class="book-info">
                        <h3>{{ book.title }}</h3>
                        <p>
                            {% for author in book.authors %}
                                {{ author.name }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                    </div>
                </a>
            </div>
        {% else %}
            <p>Geen boeken in deze categorie.</p>
        {% endfor %}
    </div>
{% endblock %}
