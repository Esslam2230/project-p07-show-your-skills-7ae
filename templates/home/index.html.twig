{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
    {{ parent() }}

    <!-- HOME HERO SECTION -->
    <div class="home-hero">
        <img class="home-hero-img" src="{{ asset('images/home-hero.jpg') }}" alt="achtergrond">
        <div class="home-overlay"></div>
        <div class="home-hero-text">
            <h1 class="home-hero-title">Welkom bij Onze Bibliotheek</h1>
            <p class="home-hero-description">
                Ontdek een wereld vol kennis binnen handbereik. Blader, verken en geniet van boeken in alle genres – van tijdloze klassiekers tot moderne favorieten.
            </p>
        </div>
    </div>

    <!-- HOME FEATURE BLOCK 1 -->
    <div class="home-feature-block">
        <div class="home-feature-text">
            <h2 class="home-feature-title">Wat is AE Library?</h2>
            <p class="home-feature-description">
                AE Library is een moderne bibliotheek waar kennis, creativiteit en ontwikkeling centraal staan. Met een brede collectie boeken en digitale bronnen biedt AE Library voor iedereen iets—van ontspanning tot educatie. Het is een rustige plek waar bezoekers kunnen lezen, leren en nieuwe ideeën ontdekken.
            </p>
        </div>
        <div class="home-feature-image" style="float:right;">
            <img class="home-feature-img" src="{{ asset('images/whay-home.png') }}" alt="voorbeeld afbeelding" style="width:500px; height:auto;">
        </div>
    </div>

    <!-- HOME FEATURE BLOCK 2 -->
    <div class="home-feature-block">
        <div class="home-feature-image" style="float:left;">
            <img class="home-feature-img" src="{{ asset('images/why-home.png') }}" alt="voorbeeld afbeelding" style="width:500px; height:auto;">
        </div>
        <div class="home-feature-text">
            <h2 class="home-feature-title">Waarom kiezen voor AE Library?</h2>
            <p class="home-feature-description">
                AE Library maakt informatie toegankelijk voor iedereen en stimuleert persoonlijke groei. Of het nu gaat om school, werk of vrije tijd, hier vind je de juiste middelen en een fijne omgeving om te focussen. AE Library staat voor kwaliteit, rust en inspiratie.
            </p>
        </div>
    </div>

{% endblock %}