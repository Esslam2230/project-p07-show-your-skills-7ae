{% extends 'base.html.twig' %}

{% block title %}Alle schrijvers{% endblock %}

{% block body %}

    <h1 class="page-title">Alle schrijvers</h1>

    <div class="author-grid-frame">
        <div class="author-grid">
            {% for author in authors %}
                <div class="author-card">
                    <a href="{{ path('author_show', {id: author.id}) }}">
                        <img src="{{ asset('img/' ~ author.img) }}" alt="{{ author.name }}">
                        <div class="author-name">{{ author.name }}</div>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>

    <style>
        .page-title {
            text-align: center;
            font-size: 2.5rem;
            color: #4a2e10;
            margin-bottom: 40px;
        }

        .author-grid-frame {
            max-width: 1000px;
            margin: 0 auto;
            padding: 30px;
            border: 15px solid #a87328; /* wooden frame */
            border-radius: 15px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.3);
        }

        .author-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .author-card {
            position: relative;
            overflow: hidden;
            border-radius: 10px;
            border: 5px solid #a87328; /* mini frame around each author */
            transition: transform 0.3s, box-shadow 0.3s, rotate 0.3s;
        }

        .author-card img {
            width: 100%;
            display: block;
            border-bottom: 3px solid #a87328;
            transition: transform 0.3s;
        }

        .author-card:hover {
            transform: translateY(-5px) rotate(-1deg);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }

        .author-card:hover img {
            transform: scale(1.05);
        }

        .author-name {
            position: absolute;
            bottom: 0;
            width: 100%;
            text-align: center;
            background: rgba(0,0,0,0.5);
            color: white;
            padding: 5px 0;
            font-weight: bold;
            font-size: 1rem;
        }
    </style>

{% endblock %}