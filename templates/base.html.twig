<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="{{ asset('css/layout.css') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
{#            {% block importmap %}{{ importmap('app') }}{% endblock %}#}
        {% endblock %}
    </head>
    <body>
        {% block body %}
            <!-- Bootstrap + pencil header -->
            <div class="home-round">
                <header class="pencil-header d-flex align-items-center">

                    <div class="pencil-tip"></div>
                    <div class="pencil-wood-trapezoid"></div>

                    <div class="pencil-body flex-grow-1">
                        <nav class="navbar navbar-expand-lg">

                            <div class="container-fluid">

                                <a class="navbar-brand" href="{{ path('home_page') }}">
                                    <img src="{{ asset('images/logo.png') }}" alt="AE Library Logo" style="height:40px;">                                </a>

                                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                                    <span class="navbar-toggler-icon"></span>
                                </button>

                                <div class="collapse navbar-collapse" id="navMenu">
                                    <ul class="navbar-nav mx-auto">

                                        <li class="nav-item"><a class="nav-link" href="{{ path('home_page') }}">Home</a></li>
                                        <li class="nav-item"><a class="nav-link" href="{{ path('app_book') }}">Books</a></li>
                                        <li class="nav-item"><a class="nav-link" href="{{ path('app_author') }}">Author</a></li>
                                        <li class="nav-item"><a class="nav-link" href="{{ path('app_category') }}">Categories</a></li>
                                        <li class="nav-item"><a class="nav-link" href="{{ path('app_contact') }}">Contact</a></li>



                                        {% if not app.user %}
                                            <li class="nav-item">
                                                <a class="nav-link" href="{{ path('app_register') }}">Register</a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" href="{{ path('app_login') }}">Login</a>
                                            </li>
                                        {% else %}
                                            {% if 'ROLE_ADMIN' in app.user.roles %}
                                                <li class="nav-item">
                                                    <a class="nav-link" href="{{ path('app_admin') }}">Admin</a>
                                                </li>
                                            {% else %}
                                                <li class="nav-item">
                                                    <a class="nav-link" href="{{ path('app_user') }}">Profile</a>
                                                </li>
                                            {% endif %}
                                            <li class="nav-item">
                                                <a class="nav-link text-danger" href="{{ path('app_logout') }}">Logout</a>
                                            </li>
                                        {% endif %}

                                    </ul>


                                </div>

                            </div>

                        </nav>
                    </div>

                    <div class="pencil-metal"></div>
                    <div class="pencil-eraser"></div>

                </header>
            </div>
        {% endblock %}
    </body>
    {% block footer %}
        <footer class="cool-footer">
            <div class="bookshelf-footer">
                <div class="book-footer" style="background:#f3d250;">Over Ons</div>
                <div class="book-footer" style="background:#e07b39;">Contact</div>
                <div class="book-footer" style="background:#7bbf6a;">Privacy</div>
                <div class="book-footer" style="background:#4a90e2;">Help</div>
                <div class="book-footer" style="background:#d96ca6;">Blog</div>
            </div>
            <p class="footer-text">© 2026 Bibliotheek Portal</p>
        </footer>


    {% endblock %}
</html>
